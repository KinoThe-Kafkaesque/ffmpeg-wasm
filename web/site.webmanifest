  "description": "Private browser MKV, MP4, WebM, AVI, TS, MP3, FLAC, and Ogg playback powered by FFmpeg WASM.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0B0C0F",
